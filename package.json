{
  "name": "pi-task-agents",
  "version": "0.1.1",
  "description": "Persistent role-based child agents for Pi Coding Agent",
  "keywords": [
    "agents",
    "pi-extension",
    "pi-package",
    "tasks"
  ],
  "homepage": "https://github.com/syxc/pi-task-agents#readme",
  "bugs": {
    "url": "https://github.com/syxc/pi-task-agents/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/syxc/pi-task-agents.git"
  },
  "files": [
    ".oxfmtrc.json",
    ".oxlintrc.json",
    ".markdownlint-cli2.jsonc",
    "src/",
    "prompts/",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md",
    "examples/",
    "docs/",
    "test/",
    "scripts/",
    "tsconfig.json",
    "tsconfig.test.json",
    "pnpm-workspace.yaml",
    "upstream.lock.json"
  ],
  "type": "module",
  "exports": {
    ".": "./src/extension.ts",
    "./engine": "./src/engine.ts",
    "./config": "./src/config.ts",
    "./backend": "./src/pi-backend.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "test": "node scripts/test.mjs",
    "test:e2e": "node scripts/test-e2e.mjs",
    "check": "pnpm run typecheck && pnpm run typecheck:test && node scripts/check.mjs && pnpm run upstream:verify && pnpm run lint && pnpm run lint:type-aware && pnpm run lint:markdown && pnpm run format:check",
    "lint": "oxlint -c .oxlintrc.json .",
    "lint:markdown": "markdownlint-cli2",
    "lint:markdown:fix": "markdownlint-cli2 --fix",
    "lint:type-aware": "oxlint --type-aware -c .oxlintrc.json --report-unused-disable-directives-severity=off -A correctness -A suspicious -A perf -A style -A restriction -A pedantic -A nursery -D typescript/await-thenable -D typescript/no-floating-promises -D typescript/no-unnecessary-type-assertion -D typescript/switch-exhaustiveness-check src",
    "format": "oxfmt .oxlintrc.json .oxfmtrc.json .markdownlint-cli2.jsonc '**/*.{mjs,json,jsonc,ts,tsx}'",
    "format:check": "oxfmt --check .oxlintrc.json .oxfmtrc.json .markdownlint-cli2.jsonc '**/*.{mjs,json,jsonc,ts,tsx}'",
    "pack": "node scripts/pack.mjs",
    "upstream:verify": "node scripts/upstream.mjs --verify",
    "upstream:check": "node scripts/upstream.mjs --check",
    "upstream:sync": "node scripts/upstream.mjs --sync"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@earendil-works/pi-tui": "1.5.0",
    "@types/node": "22.20.5",
    "markdownlint-cli2": "0.24.0",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "7.0.2006",
    "typebox": "1.3.27",
    "typescript": "7.0.2",
    "typescript-fixture": "npm:typescript@5.9.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@11.15.1",
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ]
  }
}
