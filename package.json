{
  "name": "pi-task-agents",
  "version": "0.1.0",
  "description": "Persistent role-based child agents for Pi Coding Agent",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "agents",
    "tasks"
  ],
  "exports": {
    ".": "./src/extension.ts",
    "./engine": "./src/engine.ts",
    "./config": "./src/config.ts",
    "./backend": "./src/pi-backend.ts"
  },
  "files": [
    "src/",
    "prompts/",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md",
    "examples/",
    "docs/",
    "test/",
    "scripts/",
    "tsconfig.json",
    "upstream.lock.json"
  ],
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "check": "npm run typecheck && node scripts/check.mjs && npm run upstream:verify",
    "pack": "node scripts/pack.mjs",
    "upstream:verify": "node scripts/upstream.mjs --verify",
    "upstream:check": "node scripts/upstream.mjs --check",
    "upstream:sync": "node scripts/upstream.mjs --sync"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@types/node": "22.20.5",
    "typebox": "1.3.27",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/syxc/pi-task-agents.git"
  },
  "homepage": "https://github.com/syxc/pi-task-agents#readme",
  "bugs": {
    "url": "https://github.com/syxc/pi-task-agents/issues"
  }
}
